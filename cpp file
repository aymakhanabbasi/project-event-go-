/* ===================== SEAT CLASS ===================== */
class Seat {
public:
    int seatId;
    string row;
    bool status;

    Seat(int id, string r) {
        seatId = id;
        row = r;
        status = false;
    }

    void displaySeat() {
        cout << "Seat " << seatId << " (" << row << ") - "
             << (status ? "Reserved" : "Available") << endl;
    }

    void reserve() {
        status = true;
    }

    void release() {
        status = false;
    }
};

/* ===================== EVENT CLASS ===================== */
class Event {
public:
    int eventId;
    string title;
    string date;
    vector<Seat> seats;

    Event(int id, string t, string d) {
        eventId = id;
        title = t;
        date = d;

        // Create 5 seats
        for (int i = 1; i <= 5; i++) {
            seats.push_back(Seat(i, "A"));
        }
    }

    void displayEvent() {
        cout << "\nEvent ID: " << eventId;
        cout << "\nTitle: " << title;
        cout << "\nDate: " << date << endl;
    }

    void showSeats() {
        cout << "\n--- SEATS ---\n";
        for (auto &s : seats) {
            s.displaySeat();
        }
    }

    bool bookSeat(int seatId) {
        for (auto &s : seats) {
            if (s.seatId == seatId && !s.status) {
                s.reserve();
                return true;
            }
        }
        return false;
    }
};

