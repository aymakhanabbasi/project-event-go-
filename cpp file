/* ===================== BOOKING CLASS ===================== */
class Booking {
public:
    int bookingId;
    int userId;
    int eventId;
    bool status;

    Booking() {
        status = false;
    }

    void create(int bId, int uId, int eId) {
        bookingId = bId;
        userId = uId;
        eventId = eId;
        status = true;

        cout << "\nBooking Created Successfully!\n";
        cout << "Booking ID: " << bookingId << endl;
    }

    void cancel() {
        status = false;
        cout << "\nBooking Cancelled.\n";
    }
};

/* ===================== TICKET CLASS ===================== */
class Ticket {
public:
    int ticketId;
    string qrCode;

    void generate(int id) {
        ticketId = id;
        qrCode = "QR-" + to_string(id);

        cout << "\nTicket Generated!\n";
        cout << "Ticket ID: " << ticketId << endl;
        cout << "QR Code: " << qrCode << endl;
    }
};

/* ===================== MAIN FUNCTION ===================== */
int main() {
    User user;
    Admin admin;

    vector<Event> events;   // ALL EVENTS STORED HERE
    Booking booking;
    Ticket ticket;

    int choice;

    while (true) {

        cout << "\n========== EVENTGO SYSTEM ==========\n";
        cout << "1. Login User\n";
        cout << "2. View User Details\n";
        cout << "3. Add Event (Admin)\n";
        cout << "4. View Events\n";
        cout << "5. View Seats (First Event)\n";
        cout << "6. Book Seat\n";
        cout << "7. Generate Ticket\n";
        cout << "8. Cancel Booking\n";
        cout << "9. Admin Reports\n";
        cout << "10. Logout\n";
        cout << "0. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        /* ===================== MENU ===================== */

        if (choice == 1) {
            user.login();
        }

        else if (choice == 2) {
            user.getDetails();
        }

        else if (choice == 3) {
            admin.addEvent(events);
        }

        else if (choice == 4) {
            if (events.empty()) {
                cout << "\nNo events available!\n";
            } else {
                for (auto &e : events) {
                    e.displayEvent();
                }
            }
        }

        else if (choice == 5) {
            if (!events.empty()) {
                events[0].showSeats();
            } else {
                cout << "\nNo events available!\n";
            }
        }

        else if (choice == 6) {
            if (!events.empty()) {
                int seatId;
                cout << "Enter Seat ID: ";
                cin >> seatId;

                if (events[0].bookSeat(seatId)) {
                    booking.create(1, user.getId(), events[0].eventId);
                } else {
                    cout << "Seat not available!\n";
                }
            }
        }

        else if (choice == 7) {
            ticket.generate(1001);
        }

        else if (choice == 8) {
            booking.cancel();
        }

        else if (choice == 9) {
            admin.viewReports(events);
        }

        else if (choice == 10) {
            user.logout();
        }

        else if (choice == 0) {
            cout << "\nExiting system...\n";
            break;
        }

        else {
            cout << "Invalid choice!\n";
        }
    }

    return 0;
}
